{
  "name": "lodgy-coop",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/shared && tsc -p packages/server && tsc -p packages/client && tsc -p tsconfig.json",
    "dev": "npm run dev -w @lodgy/client",
    "build": "npm run build -w @lodgy/client",
    "experiment:cable": "vitest run --config experiments/vitest.config.ts --reporter=verbose"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
