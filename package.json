{
  "name": "lodgy-coop",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/shared && tsc -p packages/server && tsc -p packages/server/tsconfig.node.json && tsc -p packages/client && tsc -p tsconfig.json",
    "dev": "node scripts/dev.mjs",
    "share": "node scripts/share.mjs",
    "build": "npm run build -w @lodgy/client",
    "start": "npm run build && npm run start -w @lodgy/server",
    "e2e": "playwright test",
    "experiment:cable": "vitest run --config experiments/vitest.config.ts --reporter=verbose experiments/cable",
    "experiment:rv": "vitest run --config experiments/vitest.config.ts --reporter=verbose experiments/rv"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
